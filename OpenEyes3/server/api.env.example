# OpenEyes per-tool API configuration. Keep this file server-side.
# Each URL should accept POST JSON: { moduleId, values } and return JSON.
# Secrets are never exposed to the browser. Password/secret/token fields in responses are redacted.
DATABASE_API_URL=
DATABASE_API_TOKEN=
API_IP_LOOKUP_URL=
API_IP_LOOKUP_KEY=
API_EMAIL_INTEL_URL=
API_EMAIL_INTEL_KEY=
API_BREACH_SEARCH_URL=
API_BREACH_SEARCH_KEY=
API_USERNAME_SWEEP_URL=
API_USERNAME_SWEEP_KEY=
API_DOMAIN_RECON_URL=
API_DOMAIN_RECON_KEY=
API_SUBDOMAIN_ENUM_URL=
API_SUBDOMAIN_ENUM_KEY=
API_PHONE_LOOKUP_URL=
API_PHONE_LOOKUP_KEY=
# Official Discord REST API: use https://discord.com/api/v10 with a BOT token.
# The Discord tool expects a numeric user ID for this provider.
API_DISCORD_LOOKUP_URL=https://discord.com/api/v10
API_DISCORD_LOOKUP_KEY=
API_SNAPCHAT_LOOKUP_URL=
API_SNAPCHAT_LOOKUP_KEY=
API_TIKTOK_LOOKUP_URL=
API_TIKTOK_LOOKUP_KEY=
API_TELEGRAM_LOOKUP_URL=
API_TELEGRAM_LOOKUP_KEY=
API_ASN_LOOKUP_URL=
API_ASN_LOOKUP_KEY=
API_WAYBACK_URL=
API_WAYBACK_KEY=
API_WEB_FINGERPRINT_URL=
API_WEB_FINGERPRINT_KEY=
API_PASTE_SEARCH_URL=
API_PASTE_SEARCH_KEY=
