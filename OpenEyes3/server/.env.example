NODE_ENV=production
HOST=127.0.0.1
PORT=8000
PUBLIC_URL=https://openeyes.example
TRUST_PROXY=true
LOG_LEVEL=info

DATABASE_FILE=./data/openeyes.db
STATIC_DIR=../dist

# At least 32 random characters. `npm run setup` generates one.
SESSION_SECRET=
SESSION_IDLE_SECONDS=604800
SESSION_ABSOLUTE_SECONDS=2592000

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional free official social adapters
TELEGRAM_BOT_TOKEN=
TIKTOK_ACCESS_TOKEN=
SNAPCHAT_ACCESS_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=https://openeyes.example/api/auth/discord/callback
DISCORD_INVITE_URL=

# One Discord role per plan. Both must sit below the bot's own role.
DISCORD_MONTHLY_ROLE_ID=
DISCORD_LIFETIME_ROLE_ID=
# Optional fallback for plans that have no role of their own.
DISCORD_ROLE_ID=

# Only used to seed the two plans on the very first start. After that, prices,
# runtimes, daily limits and roles are managed in /admin -> plans.
PRICE_MONTHLY_USD_CENTS=900
PRICE_LIFETIME_USD_CENTS=12000

# Watch-only account keys (xpub/zpub) from your wallet. Private keys are refused.
BTC_ENABLED=false
BTC_XPUB=
# Your own node's Esplora, e.g. http://127.0.0.1:3002. With it set, no third
# party learns which addresses you watch; the fallback is only used if it is down.
BTC_ESPLORA_URL=
BTC_ESPLORA_FALLBACK_URL=https://blockstream.info/api
BTC_CONFIRMATIONS=2

LTC_ENABLED=false
LTC_XPUB=
LTC_ESPLORA_URL=
LTC_ESPLORA_FALLBACK_URL=https://litecoinspace.org/api
LTC_CONFIRMATIONS=6

RATE_URL=
RATE_TTL_SECONDS=300
BTC_USD_RATE=
LTC_USD_RATE=

INVOICE_TTL_SECONDS=1800
INVOICE_UNDERPAY_TOLERANCE_PPM=2000
WATCH_INTERVAL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=900

# Optional. Modules without a built-in source (Discord, TikTok, breach search ...)
# are forwarded here as POST /run {moduleId, values}. Your own APIs go behind it.
MODULE_UPSTREAM_URL=
MODULE_UPSTREAM_TOKEN=

CORS_ORIGINS=

# Discord user ids that may open /admin. They also have unlimited searches.
ADMIN_DISCORD_IDS=
# Optional second factor (base32, `npm run setup` makes one). Strongly advised:
# without it, whoever takes over your Discord account holds the admin panel.
ADMIN_TOTP_SECRET=
ADMIN_IP_ALLOWLIST=
ADMIN_STEP_UP_SECONDS=900

# OpenEyes account bootstrap
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-to-a-long-random-password
OWNER_EMAIL=owner@example.com
ADMIN_USERNAMES=admin

# Paid plans redirect to this Discord shop; no fake payment processor is used.
DISCORD_SHOP_URL=https://discord.com/
VITE_DISCORD_SHOP_URL=https://discord.com/

# Optional external database API used when a tool has no direct API provider.
DATABASE_API_URL=
DATABASE_API_TOKEN=
